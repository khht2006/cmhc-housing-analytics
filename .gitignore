# Downloaded data and the built database aren't checked in - they're about
# 100 MB and `python run_all.py` recreates all of it in under a minute.
data/

# Power BI's own saved files. The .pbip project IS checked in (it's just text,
# and make_powerbi_project.py generates it), but these are binary/local.
*.pbix
*.pbit
powerbi/**/.pbi/
powerbi/**/*.abf
powerbi/**/cache.abf

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editors and OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db
