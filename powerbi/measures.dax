// =============================================================================
// DAX measures for the Power BI report.
//
// DAX is the formula language Power BI uses. A "measure" is a calculation that
// gets worked out fresh depending on what the user has filtered - pick Ontario
// and 2026, and [Housing Starts] recalculates for just that.
//
// Copy these into Power BI (see setup.md for how).
//
//
// THREE RULES THAT EVERYTHING HERE FOLLOWS
// -----------------------------------------
// These aren't style preferences. Breaking any of them gives you a number that
// looks perfectly reasonable and is wrong, which is the worst kind of bug.
//
// 1. To average a rate, divide the totals - don't average the rates.
//    Canada's arrears rate is NOT the average of the 8 regional rates. Ontario
//    has 2.1 million mortgages and PEI has a few thousand, so averaging their
//    rates treats them as equally important. Add up all the arrears, add up
//    all the mortgages, then divide.
//
// 2. Never add up two coverages.
//    The "big metro areas" numbers are already included in the "towns of
//    10,000+" numbers. Add them together and you count the same houses twice.
//    The measures below refuse to return anything if more than one is picked.
//
// 3. Leave out the publisher's own totals.
//    dim_geography[is_aggregate] and dim_credit_product[is_total] mark rows
//    that are totals of other rows. Every measure filters them out.
// =============================================================================


// -----------------------------------------------------------------------------
// Safety check for rule 2
// -----------------------------------------------------------------------------

// TRUE only when exactly one coverage is selected.
One Coverage Selected =
DISTINCTCOUNT ( dim_coverage[coverage_name] ) = 1

// Put this on a card at the top of any page with housing numbers. Better to
// show an instruction than a number that's twice what it should be.
Coverage Warning =
IF (
    NOT [One Coverage Selected],
    "Pick ONE coverage. The metro areas are already inside the towns figure, so adding both counts houses twice."
)


// -----------------------------------------------------------------------------
// Housing - the basic numbers
// -----------------------------------------------------------------------------

Housing Starts =
IF (
    [One Coverage Selected],
    CALCULATE (
        SUM ( fact_housing_activity[units] ),
        dim_construction_stage[stage_short] = "Starts",
        dim_geography[is_aggregate] = FALSE ()
    )
)

Housing Completions =
IF (
    [One Coverage Selected],
    CALCULATE (
        SUM ( fact_housing_activity[units] ),
        dim_construction_stage[stage_short] = "Completions",
        dim_geography[is_aggregate] = FALSE ()
    )
)

// "Under construction" is a COUNT AT A MOMENT, not a monthly total. The same
// house is still under construction next month, so adding up 12 months would
// count it 12 times. Instead we take the most recent month in whatever range
// is selected. (The jargon for this is "semi-additive".)
Under Construction =
IF (
    [One Coverage Selected],
    CALCULATE (
        SUM ( fact_housing_activity[units] ),
        dim_construction_stage[stage_short] = "Under construction",
        dim_geography[is_aggregate] = FALSE (),
        LASTDATE ( dim_date[date] )
    )
)


// -----------------------------------------------------------------------------
// Comparing to last year
//
// Housing is extremely seasonal - hardly anything gets built in a Canadian
// January. So comparing this month to last month mostly measures the weather.
// Comparing to the SAME MONTH last year is the honest comparison, and a rolling
// 12-month total is the honest trend line.
// -----------------------------------------------------------------------------

Housing Starts Last Year =
CALCULATE ( [Housing Starts], DATEADD ( dim_date[date], -12, MONTH ) )

Housing Starts Change =
[Housing Starts] - [Housing Starts Last Year]

// DIVIDE instead of "/" because DIVIDE returns blank on divide-by-zero
// instead of an error.
Housing Starts Change % =
DIVIDE ( [Housing Starts Change], [Housing Starts Last Year] )

Housing Starts 12 Months =
CALCULATE (
    [Housing Starts],
    DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH )
)

Housing Completions 12 Months =
CALCULATE (
    [Housing Completions],
    DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH )
)


// -----------------------------------------------------------------------------
// The bottleneck measures
//
// HEADS UP: CMHC stopped publishing completions and under-construction for
// whole provinces after December 2022. They still publish all three for the
// big metro areas. So these measures only work on "Big metro areas only" for
// recent years - that's the data, not a bug.
// -----------------------------------------------------------------------------

// Under 1 means more homes are being started than finished.
Completion Ratio =
DIVIDE ( [Housing Completions 12 Months], [Housing Starts 12 Months] )

// The headline number: at the recent finishing rate, how many months to
// finish everything currently under construction?
Backlog Months =
DIVIDE ( [Under Construction], DIVIDE ( [Housing Completions 12 Months], 12 ) )

Backlog Months Last Year =
CALCULATE ( [Backlog Months], DATEADD ( dim_date[date], -12, MONTH ) )

Backlog Months Change =
[Backlog Months] - [Backlog Months Last Year]

// Finished homes still sitting empty.
Unsold Inventory =
CALCULATE (
    SUM ( fact_market_absorption[unabsorbed_inventory] ),
    dim_geography[is_aggregate] = FALSE (),
    LASTDATE ( dim_date[date] )
)

Homes Sold Or Rented =
CALCULATE (
    SUM ( fact_market_absorption[absorptions] ),
    dim_geography[is_aggregate] = FALSE ()
)

Percent Unsold =
DIVIDE ( [Unsold Inventory], [Unsold Inventory] + [Homes Sold Or Rented] )


// -----------------------------------------------------------------------------
// Mortgage delinquency
//
// This section is rule 1 in action. Look at [Arrears Rate] below - it divides
// two SUMs. That is the whole point.
// -----------------------------------------------------------------------------

Total Mortgages =
SUM ( fact_mortgage_arrears[total_mortgages] )

Mortgages In Arrears =
SUM ( fact_mortgage_arrears[mortgages_in_arrears] )

// Correct: add up the parts, then divide.
Arrears Rate =
DIVIDE ( [Mortgages In Arrears], [Total Mortgages] )

Arrears Rate Last Year =
CALCULATE ( [Arrears Rate], DATEADD ( dim_date[date], -12, MONTH ) )

// Reported in PERCENTAGE POINTS, not percent change. Going from 0.20% to
// 0.30% is "up 0.10 percentage points". Calling that "up 50%" is technically
// true but tells nobody anything useful.
Arrears Rate Change (points) =
( [Arrears Rate] - [Arrears Rate Last Year] ) * 100

// Monthly arrears counts are small, so the line is jumpy. This smooths it.
Arrears Rate 3 Month Average =
AVERAGEX (
    DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -3, MONTH ),
    [Arrears Rate]
)

Mortgage Rate =
AVERAGE ( fact_mortgage_rate[rate_5year] )

// Most Canadian mortgages renew every few years. If rates jumped and arrears
// start rising about 18 months later, that points at people struggling with a
// bigger payment after renewing - rather than, say, job losses.
Mortgage Rate 18 Months Ago =
CALCULATE ( [Mortgage Rate], DATEADD ( dim_date[date], -18, MONTH ) )


// -----------------------------------------------------------------------------
// "What changed?"
//
// Ranking places by growth PERCENTAGE always puts the tiniest places first - a
// 100% rise in Charlottetown is 29 houses. This ranks by how much each place
// actually moved the national total, which is what people mean when they ask.
// -----------------------------------------------------------------------------

Share Of National Change =
VAR ThisPlace = [Housing Starts Change]
VAR TotalMovement =
    SUMX (
        CALCULATETABLE (
            VALUES ( dim_geography[geo_name] ),
            REMOVEFILTERS ( dim_geography ),
            dim_geography[is_aggregate] = FALSE (),
            dim_geography[geo_level] = SELECTEDVALUE ( dim_geography[geo_level] )
        ),
        ABS ( [Housing Starts Change] )
    )
RETURN DIVIDE ( ThisPlace, TotalMovement )

// A sentence for a card at the top of the page. A dashboard should say what
// happened, not just draw it and leave the reader to work it out.
Headline =
VAR Change = [Housing Starts Change]
VAR Percent = [Housing Starts Change %]
VAR UpOrDown = IF ( Change >= 0, "up", "down" )
VAR Place = SELECTEDVALUE ( dim_geography[geo_name], "Canada" )
RETURN
    IF (
        ISBLANK ( Change ),
        "No comparable month last year",
        Place & ": housing starts " & UpOrDown & " "
            & FORMAT ( ABS ( Change ), "#,0" ) & " homes ("
            & FORMAT ( ABS ( Percent ), "0.0%" ) & ") vs the same month last year"
    )


// -----------------------------------------------------------------------------
// Mortgage lending
// -----------------------------------------------------------------------------

// NEW money lent this month on homes.
//
// TWO filters here, and both are needed:
//
//   product_family = "Residential mortgage"
//       The Bank of Canada table also contains business loans, credit cards,
//       and a second copy of variable-rate mortgages sliced a different way.
//       Without this filter you'd be adding all of that to your housing number.
//
//   is_total = FALSE
//       Rows starting with "Total," are subtotals of the rows beneath them.
//
// The source publishes these in millions, so we multiply up to real dollars
// and let Power BI handle the formatting.
New Mortgage Lending =
CALCULATE (
    SUM ( fact_mortgage_originations[funds_advanced_millions] ),
    dim_credit_product[product_family] = "Residential mortgage",
    dim_credit_product[is_total] = FALSE ()
) * 1000000

New Mortgage Lending 12 Months =
CALCULATE (
    [New Mortgage Lending],
    DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH )
)

// TOTAL money still owed. This is rule 3 from the top of the file: it's a
// snapshot, not a monthly total, so we take the latest month rather than
// adding months together.
Mortgage Debt Outstanding =
CALCULATE (
    SUM ( fact_mortgage_originations[outstanding_balance_millions] ),
    dim_credit_product[product_family] = "Residential mortgage",
    dim_credit_product[is_total] = FALSE (),
    LASTDATE ( dim_date[date] )
) * 1000000

// Rule 1 again. Averaging interest rates treats a $1 million mortgage and a
// $100 million one as equally important. Weighting by how much was actually
// lent is what makes this mean anything.
Average Rate On New Lending =
VAR MortgageRows =
    CALCULATETABLE (
        fact_mortgage_originations,
        dim_credit_product[product_family] = "Residential mortgage",
        dim_credit_product[is_total] = FALSE ()
    )
RETURN
    DIVIDE (
        SUMX (
            MortgageRows,
            fact_mortgage_originations[interest_rate]
                * fact_mortgage_originations[funds_advanced_millions]
        ),
        SUMX ( MortgageRows, fact_mortgage_originations[funds_advanced_millions] )
    )

// What share of new lending is variable rate? Jumps around a lot with where
// people think rates are heading, so it's a decent read on borrower sentiment.
Variable Rate Share =
DIVIDE (
    CALCULATE ( [New Mortgage Lending], dim_credit_product[rate_type] = "Variable" ),
    CALCULATE ( [New Mortgage Lending],
                dim_credit_product[rate_type] IN { "Variable", "Fixed" } )
)


// -----------------------------------------------------------------------------
// House prices
//
// An index is not a quantity - you can never add index values together, and
// averaging across cities is dodgy too because each city is weighted
// differently. Only ever compare an index to itself over time.
// -----------------------------------------------------------------------------

Price Index =
AVERAGE ( fact_price_index[index_value] )

Price Index Change % =
VAR LastYear = CALCULATE ( [Price Index], DATEADD ( dim_date[date], -12, MONTH ) )
RETURN DIVIDE ( [Price Index] - LastYear, LastYear )


// -----------------------------------------------------------------------------
// Data quality, shown in the report itself
//
// Putting the checks on a page of the dashboard is what earns trust. Someone
// who can see that 600,000+ comparisons were run against the published numbers
// will believe the report far more than someone just told to.
// -----------------------------------------------------------------------------

Checks Run =
COUNTROWS ( check_results )

Checks Passed =
CALCULATE ( COUNTROWS ( check_results ), check_results[passed] = TRUE () )

Check Pass Rate =
DIVIDE ( [Checks Passed], [Checks Run] )

Data Quality Status =
VAR Failed = [Checks Run] - [Checks Passed]
RETURN
    IF (
        Failed = 0,
        "All numbers match the published figures",
        FORMAT ( Failed, "#,0" ) & " numbers need review"
    )

Data Through =
"Data up to " & FORMAT ( MAX ( dim_date[date] ), "MMMM yyyy" )
