{
  "name": "SemanticModel",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:\\\\Users\\\\12898\\\\Projects\\\\cmhc-housing-analytics\\\\data\\\\exports\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Column1",
            "dataType": "string",
            "sourceColumn": "Column1",
            "isHidden": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table({\"Column1\"}, {{\"\"}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "One Coverage Selected",
            "expression": [
              "DISTINCTCOUNT ( dim_coverage[coverage_name] ) = 1"
            ]
          },
          {
            "name": "Coverage Warning",
            "expression": [
              "IF (",
              "    NOT [One Coverage Selected],",
              "    \"Pick ONE coverage. The metro areas are already inside the towns figure, so adding both counts houses twice.\"",
              ")"
            ]
          },
          {
            "name": "Housing Starts",
            "expression": [
              "IF (",
              "    [One Coverage Selected],",
              "    CALCULATE (",
              "        SUM ( fact_housing_activity[units] ),",
              "        dim_construction_stage[stage_short] = \"Starts\",",
              "        dim_geography[is_aggregate] = FALSE ()",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Housing Completions",
            "expression": [
              "IF (",
              "    [One Coverage Selected],",
              "    CALCULATE (",
              "        SUM ( fact_housing_activity[units] ),",
              "        dim_construction_stage[stage_short] = \"Completions\",",
              "        dim_geography[is_aggregate] = FALSE ()",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Under Construction",
            "expression": [
              "IF (",
              "    [One Coverage Selected],",
              "    CALCULATE (",
              "        SUM ( fact_housing_activity[units] ),",
              "        dim_construction_stage[stage_short] = \"Under construction\",",
              "        dim_geography[is_aggregate] = FALSE (),",
              "        LASTDATE ( dim_date[date] )",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Housing Starts Last Year",
            "expression": [
              "CALCULATE ( [Housing Starts], DATEADD ( dim_date[date], -12, MONTH ) )"
            ]
          },
          {
            "name": "Housing Starts Change",
            "expression": [
              "[Housing Starts] - [Housing Starts Last Year]"
            ]
          },
          {
            "name": "Housing Starts Change %",
            "expression": [
              "DIVIDE ( [Housing Starts Change], [Housing Starts Last Year] )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Housing Starts 12 Months",
            "expression": [
              "CALCULATE (",
              "    [Housing Starts],",
              "    DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Housing Completions 12 Months",
            "expression": [
              "CALCULATE (",
              "    [Housing Completions],",
              "    DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Completion Ratio",
            "expression": [
              "DIVIDE ( [Housing Completions 12 Months], [Housing Starts 12 Months] )"
            ],
            "formatString": "0.00"
          },
          {
            "name": "Backlog Months",
            "expression": [
              "DIVIDE ( [Under Construction], DIVIDE ( [Housing Completions 12 Months], 12 ) )"
            ],
            "formatString": "0.0"
          },
          {
            "name": "Backlog Months Last Year",
            "expression": [
              "CALCULATE ( [Backlog Months], DATEADD ( dim_date[date], -12, MONTH ) )"
            ],
            "formatString": "0.0"
          },
          {
            "name": "Backlog Months Change",
            "expression": [
              "[Backlog Months] - [Backlog Months Last Year]"
            ],
            "formatString": "+0.0;-0.0;0.0"
          },
          {
            "name": "Unsold Inventory",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_market_absorption[unabsorbed_inventory] ),",
              "    dim_geography[is_aggregate] = FALSE (),",
              "    LASTDATE ( dim_date[date] )",
              ")"
            ]
          },
          {
            "name": "Homes Sold Or Rented",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_market_absorption[absorptions] ),",
              "    dim_geography[is_aggregate] = FALSE ()",
              ")"
            ]
          },
          {
            "name": "Percent Unsold",
            "expression": [
              "DIVIDE ( [Unsold Inventory], [Unsold Inventory] + [Homes Sold Or Rented] )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Total Mortgages",
            "expression": [
              "SUM ( fact_mortgage_arrears[total_mortgages] )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Mortgages In Arrears",
            "expression": [
              "SUM ( fact_mortgage_arrears[mortgages_in_arrears] )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Arrears Rate",
            "expression": [
              "DIVIDE ( [Mortgages In Arrears], [Total Mortgages] )"
            ],
            "formatString": "0.00%"
          },
          {
            "name": "Arrears Rate Last Year",
            "expression": [
              "CALCULATE ( [Arrears Rate], DATEADD ( dim_date[date], -12, MONTH ) )"
            ],
            "formatString": "0.00%"
          },
          {
            "name": "Arrears Rate Change (points)",
            "expression": [
              "( [Arrears Rate] - [Arrears Rate Last Year] ) * 100"
            ]
          },
          {
            "name": "Arrears Rate 3 Month Average",
            "expression": [
              "AVERAGEX (",
              "    DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -3, MONTH ),",
              "    [Arrears Rate]",
              ")"
            ],
            "formatString": "0.00%"
          },
          {
            "name": "Mortgage Rate",
            "expression": [
              "AVERAGE ( fact_mortgage_rate[rate_5year] )"
            ],
            "formatString": "0.00"
          },
          {
            "name": "Mortgage Rate 18 Months Ago",
            "expression": [
              "CALCULATE ( [Mortgage Rate], DATEADD ( dim_date[date], -18, MONTH ) )"
            ],
            "formatString": "0.00"
          },
          {
            "name": "Share Of National Change",
            "expression": [
              "VAR ThisPlace = [Housing Starts Change]",
              "VAR TotalMovement =",
              "    SUMX (",
              "        CALCULATETABLE (",
              "            VALUES ( dim_geography[geo_name] ),",
              "            REMOVEFILTERS ( dim_geography ),",
              "            dim_geography[is_aggregate] = FALSE (),",
              "            dim_geography[geo_level] = SELECTEDVALUE ( dim_geography[geo_level] )",
              "        ),",
              "        ABS ( [Housing Starts Change] )",
              "    )",
              "RETURN DIVIDE ( ThisPlace, TotalMovement )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Headline",
            "expression": [
              "VAR Change = [Housing Starts Change]",
              "VAR Percent = [Housing Starts Change %]",
              "VAR UpOrDown = IF ( Change >= 0, \"up\", \"down\" )",
              "VAR Place = SELECTEDVALUE ( dim_geography[geo_name], \"Canada\" )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( Change ),",
              "        \"No comparable month last year\",",
              "        Place & \": housing starts \" & UpOrDown & \" \"",
              "            & FORMAT ( ABS ( Change ), \"#,0\" ) & \" homes (\"",
              "            & FORMAT ( ABS ( Percent ), \"0.0%\" ) & \") vs the same month last year\"",
              "    )"
            ]
          },
          {
            "name": "New Mortgage Lending",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_mortgage_originations[funds_advanced_millions] ),",
              "    dim_credit_product[product_family] = \"Residential mortgage\",",
              "    dim_credit_product[is_total] = FALSE ()",
              ") * 1000000"
            ],
            "formatString": "$#,0,,\" M\""
          },
          {
            "name": "New Mortgage Lending 12 Months",
            "expression": [
              "CALCULATE (",
              "    [New Mortgage Lending],",
              "    DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH )",
              ")"
            ],
            "formatString": "$#,0,,\" M\""
          },
          {
            "name": "Mortgage Debt Outstanding",
            "expression": [
              "CALCULATE (",
              "    SUM ( fact_mortgage_originations[outstanding_balance_millions] ),",
              "    dim_credit_product[product_family] = \"Residential mortgage\",",
              "    dim_credit_product[is_total] = FALSE (),",
              "    LASTDATE ( dim_date[date] )",
              ") * 1000000"
            ],
            "formatString": "$#,0,,,\" B\""
          },
          {
            "name": "Average Rate On New Lending",
            "expression": [
              "VAR MortgageRows =",
              "    CALCULATETABLE (",
              "        fact_mortgage_originations,",
              "        dim_credit_product[product_family] = \"Residential mortgage\",",
              "        dim_credit_product[is_total] = FALSE ()",
              "    )",
              "RETURN",
              "    DIVIDE (",
              "        SUMX (",
              "            MortgageRows,",
              "            fact_mortgage_originations[interest_rate]",
              "                * fact_mortgage_originations[funds_advanced_millions]",
              "        ),",
              "        SUMX ( MortgageRows, fact_mortgage_originations[funds_advanced_millions] )",
              "    )"
            ],
            "formatString": "0.00"
          },
          {
            "name": "Variable Rate Share",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( [New Mortgage Lending], dim_credit_product[rate_type] = \"Variable\" ),",
              "    CALCULATE ( [New Mortgage Lending],",
              "                dim_credit_product[rate_type] IN { \"Variable\", \"Fixed\" } )",
              ")"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Price Index",
            "expression": [
              "AVERAGE ( fact_price_index[index_value] )"
            ],
            "formatString": "0.0"
          },
          {
            "name": "Price Index Change %",
            "expression": [
              "VAR LastYear = CALCULATE ( [Price Index], DATEADD ( dim_date[date], -12, MONTH ) )",
              "RETURN DIVIDE ( [Price Index] - LastYear, LastYear )"
            ],
            "formatString": "0.0%"
          },
          {
            "name": "Checks Run",
            "expression": [
              "COUNTROWS ( check_results )"
            ]
          },
          {
            "name": "Checks Passed",
            "expression": [
              "CALCULATE ( COUNTROWS ( check_results ), check_results[passed] = TRUE () )"
            ]
          },
          {
            "name": "Check Pass Rate",
            "expression": [
              "DIVIDE ( [Checks Passed], [Checks Run] )"
            ],
            "formatString": "0.00%"
          },
          {
            "name": "Data Quality Status",
            "expression": [
              "VAR Failed = [Checks Run] - [Checks Passed]",
              "RETURN",
              "    IF (",
              "        Failed = 0,",
              "        \"All numbers match the published figures\",",
              "        FORMAT ( Failed, \"#,0\" ) & \" numbers need review\"",
              "    )"
            ]
          },
          {
            "name": "Data Through",
            "expression": [
              "\"Data up to \" & FORMAT ( MAX ( dim_date[date] ), \"MMMM yyyy\" )"
            ]
          }
        ]
      },
